pkgname=localdesk
pkgver=@VERSION@
pkgrel=1
pkgdesc='Linux/niri local operations, telemetry, remote files, and notes console'
arch=('x86_64')
license=('MIT')
depends=(
  'curl'
  'glib2'
  'gtk3'
  'libbpf'
  'libsecret'
  'niri'
  'openssh'
  'smbclient'
  'sqlite'
  'systemd'
  'wayland'
  'webkit2gtk-4.1'
  'xdg-desktop-portal'
)
makedepends=('clang' 'llvm' 'nodejs' 'pnpm' 'rust')
optdepends=('xdg-desktop-portal-gtk: native file picker backend')
options=('!strip')
source=("$pkgname-$pkgver-x86_64.tar.zst")
sha256sums=('@SOURCE_SHA256@')

package() {
  cp -a "$srcdir/etc" "$srcdir/usr" "$pkgdir/"
}
